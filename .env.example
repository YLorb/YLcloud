# Copy this file to .env and provide local-only values.
# Never commit real API keys.

# Local infrastructure. Real JWT/API secrets live in .secrets/, not this file.
YLCLOUD_SPRING_PROFILE=dev
YLCLOUD_INFRA_BIND_ADDRESS=127.0.0.1
YLCLOUD_PUBLIC_BIND_ADDRESS=0.0.0.0
YLCLOUD_MYSQL_HOST_PORT=3306
YLCLOUD_MINIO_API_HOST_PORT=9000
YLCLOUD_MINIO_CONSOLE_HOST_PORT=9001
YLCLOUD_QDRANT_REST_HOST_PORT=6333
YLCLOUD_QDRANT_GRPC_HOST_PORT=6334
YLCLOUD_MODEL_HOST_PORT=8001
YLCLOUD_PARSER_HOST_PORT=8002
YLCLOUD_BACKEND_HOST_PORT=8080
YLCLOUD_FRONTEND_HOST_PORT=5173
YLCLOUD_MYSQL_ROOT_PASSWORD=ylcloud_root
YLCLOUD_MYSQL_DATABASE=ylcloud
YLCLOUD_MYSQL_USER=ylcloud
YLCLOUD_MYSQL_PASSWORD=ylcloud_pwd
YLCLOUD_MINIO_ACCESS_KEY=ylcloud_minio
YLCLOUD_MINIO_SECRET_KEY=ylcloud_minio_pwd
YLCLOUD_MINIO_BUCKET=localbucket1

# Optional first-run administrator. It is created only when the users table is empty.
# Never commit a real password. Keep disabled unless all values below are set.
YLCLOUD_BOOTSTRAP_ADMIN_ENABLED=false
YLCLOUD_BOOTSTRAP_ADMIN_USERNAME=
YLCLOUD_BOOTSTRAP_ADMIN_PASSWORD=
YLCLOUD_BOOTSTRAP_ADMIN_NICKNAME=YLcloud Administrator

# Keep true for connectivity-only development. Set false for real model validation.
YLCLOUD_MODEL_SERVICE_OFFLINE_FALLBACK=true
