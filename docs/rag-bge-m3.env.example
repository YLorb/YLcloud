# Optional stronger RAG embedding profile.
# Keep the default bge-small-zh-v1.5 profile for acceptance unless explicitly switching.

YLCLOUD_RAG_EMBEDDING_MODEL=BAAI/bge-m3
YLCLOUD_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
YLCLOUD_RAG_EMBEDDING_DIMENSION=1024
YLCLOUD_RAG_QDRANT_COLLECTION_NAME=ylcloud_rag_bge_m3_v1

# Disable hash-based fallback when validating real retrieval quality.
YLCLOUD_MODEL_SERVICE_OFFLINE_FALLBACK=false

# Switching embedding dimensions requires a new Qdrant collection or a cleared/recreated old one.
# Rebuild space/file RAG indexes after changing this profile.

# RAG indexing execution controls.
YLCLOUD_RAG_INDEX_CONCURRENCY=5
YLCLOUD_RAG_INDEX_TASK_TIMEOUT_MINUTES=10
