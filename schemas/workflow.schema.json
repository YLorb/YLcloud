{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mini-agent-flow/workflow.schema.json",
  "title": "Mini Agent Flow Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "nodes"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/startNode"
          },
          {
            "$ref": "#/$defs/endNode"
          },
          {
            "$ref": "#/$defs/llmNode"
          },
          {
            "$ref": "#/$defs/toolNode"
          },
          {
            "$ref": "#/$defs/conditionNode"
          },
          {
            "$ref": "#/$defs/loopNode"
          }
        ]
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "variableName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "backoff_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "baseNodeFields": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        }
      }
    },
    "startNode": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNodeFields"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "next"],
          "properties": {
            "id": {
              "$ref": "#/$defs/nodeId"
            },
            "type": {
              "const": "start"
            },
            "description": {
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/metadata"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "next": {
              "$ref": "#/$defs/nodeId"
            }
          }
        }
      ]
    },
    "endNode": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNodeFields"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type"],
          "properties": {
            "id": {
              "$ref": "#/$defs/nodeId"
            },
            "type": {
              "const": "end"
            },
            "description": {
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/metadata"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            }
          }
        }
      ]
    },
    "llmNode": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNodeFields"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "prompt", "output", "next"],
          "properties": {
            "id": {
              "$ref": "#/$defs/nodeId"
            },
            "type": {
              "const": "llm"
            },
            "description": {
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/metadata"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "$ref": "#/$defs/variableName"
            },
            "next": {
              "$ref": "#/$defs/nodeId"
            }
          }
        }
      ]
    },
    "toolNode": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNodeFields"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "tool", "input", "output", "next"],
          "properties": {
            "id": {
              "$ref": "#/$defs/nodeId"
            },
            "type": {
              "const": "tool"
            },
            "description": {
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/metadata"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "tool": {
              "$ref": "#/$defs/nodeId"
            },
            "input": true,
            "output": {
              "$ref": "#/$defs/variableName"
            },
            "next": {
              "$ref": "#/$defs/nodeId"
            }
          }
        }
      ]
    },
    "conditionNode": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNodeFields"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "expression", "if_true", "if_false"],
          "properties": {
            "id": {
              "$ref": "#/$defs/nodeId"
            },
            "type": {
              "const": "condition"
            },
            "description": {
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/metadata"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "if_true": {
              "$ref": "#/$defs/nodeId"
            },
            "if_false": {
              "$ref": "#/$defs/nodeId"
            }
          }
        }
      ]
    },
    "loopNode": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNodeFields"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "items", "item_var", "body", "next"],
          "properties": {
            "id": {
              "$ref": "#/$defs/nodeId"
            },
            "type": {
              "const": "loop"
            },
            "description": {
              "type": "string"
            },
            "metadata": {
              "$ref": "#/$defs/metadata"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "items": {
              "type": "string",
              "minLength": 1
            },
            "item_var": {
              "$ref": "#/$defs/variableName"
            },
            "body": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nodeId"
              }
            },
            "next": {
              "$ref": "#/$defs/nodeId"
            }
          }
        }
      ]
    }
  }
}
