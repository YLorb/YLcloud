{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ylcloud.local/schemas/intent-plan.schema.json",
  "title": "YLcloud Intent Plan Contract",
  "oneOf": [
    {"$ref": "#/$defs/IntentPlanRequest"},
    {"$ref": "#/$defs/IntentPlanResponse"}
  ],
  "$defs": {
    "IntentCode": {
      "type": "string",
      "enum": [
        "GENERAL_QA", "EXPLAIN_CONCEPT", "HOW_TO", "COMPARE", "SUMMARIZE", "ANALYZE",
        "CONTENT_GENERATION", "CONTENT_REWRITE", "CONTENT_EXPAND", "CONTENT_SHORTEN", "TRANSLATION", "FORMAT_CONVERSION", "CODE_GENERATION", "CODE_REVIEW", "CODE_MODIFICATION",
        "MEMORY_LOOKUP", "MEMORY_SAVE", "MEMORY_UPDATE", "MEMORY_DELETE", "MEMORY_CLEAR", "MEMORY_CONFIRM", "MEMORY_CORRECTION",
        "CONTINUE_TASK", "RESUME_PROJECT", "MODIFY_PREVIOUS_RESULT", "RETRY", "REFRESH_RETRY", "ROLLBACK", "TASK_STATUS_QUERY",
        "TOOL_EXECUTION", "WEB_SEARCH", "FILE_SEARCH", "FILE_READ", "EMAIL_DRAFT", "EMAIL_SEND", "CALENDAR_QUERY", "CALENDAR_CREATE", "REMINDER_CREATE", "EXTERNAL_ACTION",
        "CONFIRMATION", "CANCEL_ACTION", "CORRECTION", "HELP", "UNKNOWN",
        "ACCOUNT_OPERATION", "PERMISSION_CHANGE", "DATA_EXPORT", "DATA_DELETE"
      ]
    },
    "ShortTermMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"type": "string", "enum": ["USER", "ASSISTANT", "SYSTEM"]},
        "content": {"type": "string", "maxLength": 32000}
      }
    },
    "IntentPlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "schemaVersion", "promptVersion", "question", "shortTermContext", "attempt", "confidenceThreshold"],
      "properties": {
        "contractVersion": {"type": "string", "const": "1.0"},
        "schemaVersion": {"type": "string", "const": "intent-plan/1.0"},
        "promptVersion": {"type": "string", "const": "intent-plan-prompt/1.0"},
        "question": {"type": "string", "minLength": 1, "maxLength": 32000},
        "shortTermContext": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/ShortTermMessage"}},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
        "confidenceThreshold": {"type": "number", "minimum": 0.7, "maximum": 0.7}
      }
    },
    "IntentTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "role", "intent", "instruction", "dependencies", "confidence", "contextSufficiency", "relevance", "uncertainty", "disposition"],
      "properties": {
        "taskId": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
        "role": {"type": "string", "enum": ["PRIMARY", "SUBTASK"]},
        "intent": {"$ref": "#/$defs/IntentCode"},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 8000},
        "dependencies": {
          "type": "array", "maxItems": 5, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "contextSufficiency": {"type": "string", "enum": ["SUFFICIENT", "PARTIAL", "INSUFFICIENT", "UNKNOWN"]},
        "relevance": {"type": "string", "enum": ["REQUIRED", "OPTIONAL", "IRRELEVANT"]},
        "uncertainty": {"type": "string", "enum": ["NONE", "ROUTING", "SECURITY", "IRRELEVANT_SUBTASK"]},
        "disposition": {"type": "string", "enum": ["ACTIVE", "SKIPPED_UNCERTAIN"]}
      }
    },
    "IntentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryTaskId", "complexity", "tasks"],
      "properties": {
        "primaryTaskId": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
        "complexity": {"type": "string", "enum": ["SIMPLE", "COMPLEX"]},
        "tasks": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/IntentTask"}}
      }
    },
    "IntentPlanResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "schemaVersion", "promptVersion", "modelVersion", "plan"],
      "properties": {
        "contractVersion": {"type": "string", "const": "1.0"},
        "schemaVersion": {"type": "string", "const": "intent-plan/1.0"},
        "promptVersion": {"type": "string", "const": "intent-plan-prompt/1.0"},
        "modelVersion": {"type": "string", "minLength": 1, "maxLength": 128},
        "plan": {"$ref": "#/$defs/IntentPlan"}
      }
    }
  }
}
