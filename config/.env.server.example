# Copy to .env.server, replace every replace-* value, create .secrets/, then run scripts/deploy-check.ps1.

# Required by docker-compose.hub.yml. Copy the exact registry domain from
# Alibaba Cloud ACR > Instance > Access Credentials. Do not include https://.
ACR_REGISTRY=crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=replace-with-your-acr-namespace

# Use dev for branch builds, latest for main, or a fixed release such as 1.0.0.
YLCLOUD_IMAGE_TAG=dev

YLCLOUD_SPRING_PROFILE=prod
YLCLOUD_INFRA_BIND_ADDRESS=127.0.0.1
YLCLOUD_PUBLIC_BIND_ADDRESS=0.0.0.0

# Change a host port here when the server already uses the default port.
YLCLOUD_MYSQL_HOST_PORT=3306
YLCLOUD_MINIO_API_HOST_PORT=9000
YLCLOUD_MINIO_CONSOLE_HOST_PORT=9001
YLCLOUD_QDRANT_REST_HOST_PORT=6333
YLCLOUD_QDRANT_GRPC_HOST_PORT=6334
YLCLOUD_MODEL_HOST_PORT=8001
YLCLOUD_PARSER_HOST_PORT=8002
YLCLOUD_BACKEND_HOST_PORT=8080
YLCLOUD_FRONTEND_HOST_PORT=5173

YLCLOUD_MYSQL_ROOT_PASSWORD=replace-with-random-root-password
YLCLOUD_MYSQL_DATABASE=ylcloud
YLCLOUD_MYSQL_USER=ylcloud
YLCLOUD_MYSQL_PASSWORD=replace-with-random-app-password
YLCLOUD_MINIO_ACCESS_KEY=replace-with-random-access-key
YLCLOUD_MINIO_SECRET_KEY=replace-with-random-secret-key
YLCLOUD_MINIO_BUCKET=ylcloud

# JWT and platform API keys are mounted from local files under .secrets/.
# Service JWT previous-secret mounts are temporary deployment overrides; when used,
# set YLCLOUD_SERVICE_JWT_PREVIOUS_VALID_UNTIL_EPOCH_SECONDS to a window <= 360 seconds.
YLCLOUD_MODEL_SERVICE_OFFLINE_FALLBACK=true
YLCLOUD_RABBITMQ_USERNAME=ylcloud_app
YLCLOUD_RABBITMQ_VHOST=/ylcloud
YLCLOUD_RABBITMQ_MANAGEMENT_HOST_PORT=15672
YLCLOUD_RABBITMQ_AMQP_HOST_PORT=5672
YLCLOUD_ASYNC_MQ_ENABLED=true
YLCLOUD_ASYNC_MQ_CLEANUP=true
YLCLOUD_ASYNC_MQ_MAINTENANCE=true
YLCLOUD_ASYNC_MQ_MEMORY=true
YLCLOUD_ASYNC_MQ_CHAT=true
YLCLOUD_ASYNC_MQ_KNOWLEDGE=true
YLCLOUD_ASYNC_MQ_RAG=true

# Gateway: external API entry; service-to-service calls remain direct.
# Redis persists under the project directory by default (D: on this workstation).
YLCLOUD_GATEWAY_REDIS_DATA_DIR=../.data/gateway-redis
YLCLOUD_EDGE_SUBNET=172.31.241.0/24
YLCLOUD_EDGE_DYNAMIC_RANGE=172.31.241.128/25
YLCLOUD_EDGE_FRONTEND_IP=172.31.241.2
# Optional dedicated Session DB account; defaults to the existing application DB credentials.
# Requires SELECT on users/user_login_session and UPDATE(last_seen_at) on user_login_session.
# YLCLOUD_GATEWAY_SESSION_DB_USER=ylcloud_gateway
# YLCLOUD_GATEWAY_SESSION_DB_PASSWORD=provision-a-secret
# Required before an administrator can select direct downloads; origin only, no path prefix.
YLCLOUD_MINIO_PUBLIC_ENDPOINT=
YLCLOUD_MINIO_REGION=us-east-1

# Short links: assign a different node ID (0..1023) to every application instance.
YLCLOUD_SHORT_LINK_NODE_ID=0
# Missing-code attempts from one IP; bans apply only to short-link access.
YLCLOUD_SHORT_LINK_MISS_THRESHOLD=10
YLCLOUD_SHORT_LINK_MISS_WINDOW_SECONDS=60
YLCLOUD_SHORT_LINK_BAN_SECONDS=900
