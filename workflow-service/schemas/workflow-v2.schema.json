    "RetryPolicy": {
      "additionalProperties": false,
      "description": "节点级重试策略。\n\nExecutor 会读取该配置，在支持 retry 的节点失败时，根据 max_attempts 和\nbackoff_seconds 决定是否重试。当前顺序执行器支持 llm / tool 节点重试。",
      "properties": {
        "backoff_seconds": {
          "default": 0,
          "minimum": 0,
